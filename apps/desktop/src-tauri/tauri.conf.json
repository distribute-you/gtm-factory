{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTM Factory",
  "version": "0.1.0",
  "identifier": "you.distribute.gtmfactory",
  "build": {
    "frontendDist": "https://factory.distribute.you"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GTM Factory",
        "url": "https://factory.distribute.you",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "hosted-site",
          "description": "The hosted site, and only it, may run a prompt on the user's Claude.",
          "windows": ["main"],
          "remote": { "urls": ["https://factory.distribute.you/*"] },
          "permissions": ["allow-claude-complete"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Business",
    "shortDescription": "GTM Factory, with your own Claude",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
