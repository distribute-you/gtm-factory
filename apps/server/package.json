{
  "name": "@gtm-factory/server",
  "private": true,
  "type": "module",
  "description": "A hosted GTM Factory: the API, the scheduler and the database, running the core with every script in an isolated V8.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--no-node-snapshot tsx src/index.ts",
    "dev": "NODE_OPTIONS=--no-node-snapshot tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gtm-factory/core": "workspace:*",
    "esbuild": "^0.28.2",
    "imapflow": "^1.0.191",
    "isolated-vm": "^7.0.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
